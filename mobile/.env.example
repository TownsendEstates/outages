# Copy to .env and fill in. Leave the Supabase values empty to run in demo mode.
# Everything here is compiled into the app and is public by design — never put
# a service-role key, RevenueCat secret key or webhook secret in this file.

# Supabase: Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the web build is hosted, used for shareable page links (no trailing slash)
EXPO_PUBLIC_WEB_URL=

# RevenueCat: Project -> API keys (the PUBLIC app-specific keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Shown on the plans screen. Apple requires both for subscription apps.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
