# Copy into Netlify > Site configuration > Environment variables. Never commit real values.

# Supabase (service role key is server side only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Ulio.ai sends on every webhook / tool call (header x-ulio-secret or ?key=)
ULIO_WEBHOOK_SECRET=

# Admin page PINs. ADMIN_PIN is Scott's. AARON_PIN is Aaron's own (set something other than the default).
ADMIN_PIN=107451
AARON_PIN=
SESSION_SECRET=   # 32+ random characters, e.g. openssl rand -hex 32

# Public URL of this Netlify site (used for transcript links in alerts and FUB notes)
SITE_URL=https://ai-line-radicalrobinson.netlify.app

# Follow Up Boss (Admin > API in FUB). Register a system at https://apps.followupboss.com/system-registration for X-System-Key.
FUB_API_KEY=
FUB_X_SYSTEM=RadicalRobinsonAI
FUB_X_SYSTEM_KEY=
FUB_ASSIGNED_USER_ID=     # Aaron's FUB user id. Leave blank to look up by AARON_EMAIL.
AARON_EMAIL=

# Alerts to Aaron
AARON_ALERT_PHONE=+1780XXXXXXX
AARON_ALERT_EMAIL=aaron@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
RESEND_API_KEY=
ALERT_FROM_EMAIL=AI Line <ailine@YOUR-VERIFIED-DOMAIN>
